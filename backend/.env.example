APP_NAME=Surfcasting Região dos Lagos API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_ALGORITHM=HS256
JWT_ISSUER=surfcasting-regiao-dos-lagos
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Em produção use true e HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=srl_access
REFRESH_COOKIE_NAME=srl_refresh
CSRF_COOKIE_NAME=srl_csrf
CSRF_HEADER_NAME=X-CSRF-Token

AUTH_RATE_LIMIT_PER_MINUTE=10
COMMUNITY_RATE_LIMIT_PER_MINUTE=30
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60

OPENWEATHER_API_KEY=substitua_pela_sua_chave
STORMGLASS_API_KEY=substitua_pela_sua_chave

# Valores para execução local fora do Docker.
MYSQL_URL=mysql+pymysql://surfcasting:surfcasting_dev@localhost:3306/surfcasting?charset=utf8mb4
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=surfcasting_dev

# SMTP é obrigatório quando APP_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@surfcasting.local
SMTP_FROM_NAME=Surfcasting Região dos Lagos
SMTP_USE_TLS=true

MEDIA_ROOT=uploads
MEDIA_PUBLIC_URL=/media
MEDIA_PUBLIC_ORIGIN=http://localhost:8000
MEDIA_MAX_IMAGE_MB=8

# Usados pelos scripts de bootstrap opcionais.
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
