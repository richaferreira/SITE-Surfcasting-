APP_NAME=Surfcasting Região dos Lagos API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=10
CORS_ORIGINS=["http://localhost:3000"]

OPENWEATHER_API_KEY=substitua_pela_sua_chave
STORMGLASS_API_KEY=substitua_pela_sua_chave

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=surfcasting-regiao-dos-lagos
JWT_AUDIENCE=surfcasting-web

MYSQL_URL=mysql+pymysql://surfcasting:surfcasting_dev@mysql:3306/surfcasting?charset=utf8mb4
MYSQL_ECHO=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=surfcasting_dev
