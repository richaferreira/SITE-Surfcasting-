APP_NAME=Surfcasting Região dos Lagos API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=10
CORS_ORIGINS=["http://localhost:3000"]

OPENWEATHER_API_KEY=substitua_pela_sua_chave
STORMGLASS_API_KEY=substitua_pela_sua_chave

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=surfcasting-regiao-dos-lagos
JWT_AUDIENCE=surfcasting-web

MYSQL_URL=mysql+pymysql://surfcasting:surfcasting_dev@mysql:3306/surfcasting?charset=utf8mb4
MYSQL_ECHO=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=surfcasting_dev

MEDIA_ROOT=uploads
MEDIA_URL_PREFIX=/media
MEDIA_MAX_UPLOAD_MB=250
MEDIA_IMAGE_MAX_DIMENSION=2400
MEDIA_IMAGE_QUALITY=82
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

SCORE_CACHE_TTL_SECONDS=600
SCORE_CACHE_MAX_ENTRIES=1000
SCORE_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
