APP_NAME=Surfcasting Região dos Lagos API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_ALGORITHM=HS256
JWT_ISSUER=surfcasting-regiao-dos-lagos
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

OPENWEATHER_API_KEY=substitua_pela_sua_chave
STORMGLASS_API_KEY=substitua_pela_sua_chave

# Valores para execução local fora do Docker.
MYSQL_URL=mysql+pymysql://surfcasting:surfcasting_dev@localhost:3306/surfcasting?charset=utf8mb4
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=surfcasting_dev

# Usados pelos scripts de bootstrap opcionais.
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
